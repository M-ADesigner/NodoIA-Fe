DATABASE_URL=postgres://usuario:clave@localhost:5432/nodoia

# Secreto para firmar los JWT (minimo 32 caracteres). Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# URL publica canonica del sitio (SEO: canonical, sitemap, Open Graph).
# Con dominio propio, ponerlo aqui. Si se omite, se usa RAILWAY_PUBLIC_DOMAIN.
SITE_URL=https://www.ejemplo.cl

# Correo (recuperacion de contrasena) por Resend, API HTTPS. Railway bloquea el
# SMTP saliente en los planes Free/Trial/Hobby. Crear la clave en
# https://resend.com/api-keys. Sin RESEND_API_KEY, en desarrollo el correo se
# imprime en la consola del servidor; en produccion el envio falla.
RESEND_API_KEY=
# Obligatorio con Resend. Sin dominio verificado solo sirve
# "NodoIA <onboarding@resend.dev>" y solo entrega al correo de la cuenta de
# Resend. Con dominio verificado: "NodoIA <no-responder@tudominio.cl>".
EMAIL_FROM=

# Content-Security-Policy: por defecto solo reporta (consola del navegador).
# Con true se aplica de verdad.
CSP_ENFORCE=false

# Solo para el seed: administrador inicial si no existe ninguno
SEED_ADMIN_EMAIL=admin@cchia.cl
SEED_ADMIN_PASSWORD=
