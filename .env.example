DATABASE_URL=postgres://usuario:clave@localhost:5432/nodoia

# Secreto para firmar los JWT (minimo 32 caracteres). Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# URL publica canonica del sitio (SEO: canonical, sitemap, Open Graph).
# Con dominio propio, ponerlo aqui. Si se omite, se usa RAILWAY_PUBLIC_DOMAIN.
SITE_URL=https://www.ejemplo.cl

# Correo (recuperacion de contrasena) por SMTP con nodemailer.
# Con Gmail: activar verificacion en 2 pasos y crear una "contrasena de
# aplicacion" en https://myaccount.google.com/apppasswords (NO la clave normal).
# Sin SMTP_USER/SMTP_PASSWORD, en desarrollo el correo se imprime en la consola.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Opcional; por defecto SMTP_USER. Gmail reescribe el remitente a la cuenta.
EMAIL_FROM=

# Content-Security-Policy: por defecto solo reporta (consola del navegador).
# Con true se aplica de verdad.
CSP_ENFORCE=false

# Solo para el seed: administrador inicial si no existe ninguno
SEED_ADMIN_EMAIL=admin@cchia.cl
SEED_ADMIN_PASSWORD=
